# Copy this file to api/.env and fill in your actual values.
# Never commit .env to version control.

# Neon Postgres connection string (Neon dashboard → your project → Connect)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Long random string used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# Single-admin login (see api/auth.py). Change both before deploying —
# the app will warn on startup if either is left at its default.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# Optional. Comma-separated origins allowed to make cross-origin
# requests. Only matters for local dev where the frontend might be
# served from a different port than the Flask API — in production,
# frontend and API share an origin and this isn't used.
# FRONTEND_ORIGINS=http://localhost:5000,http://127.0.0.1:5500

# Optional. "true" enables Flask debug mode (verbose error pages,
# auto-reload) — keep this unset/false in production.
# FLASK_DEBUG=false
